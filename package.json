{
  "name": "chess-elite",
  "version": "1.0.5",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "chess.js": "^1.4.0",
    "expo": "~56.0.19",
    "expo-audio": "~56.0.13",
    "expo-haptics": "56.0.2",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "fix": "^0.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:aab": "cd android && .\\gradlew.bat app:bundleRelease -x lint -x test --console=plain",
    "android:apk": "cd android && .\\gradlew.bat app:assembleRelease -x lint -x test --console=plain",
    "ios": "expo run:ios",
    "version:major": "node scripts/version.js major",
    "version:minor": "node scripts/version.js minor",
    "version:patch": "node scripts/version.js patch",
    "web": "expo start --web"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-haptics"
      ]
    }
  },
  "private": true
}
